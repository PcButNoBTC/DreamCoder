# Ollama lanes
DREAMCODER_OLLAMA_PRIMARY_URL=
DREAMCODER_OLLAMA_PRIMARY_MODEL=
DREAMCODER_OLLAMA_SECONDARY_URL=
DREAMCODER_OLLAMA_SECONDARY_MODEL=
DREAMCODER_OLLAMA_TERTIARY_URL=
DREAMCODER_OLLAMA_TERTIARY_MODEL=
DREAMCODER_OLLAMA_LOCAL_URL=http://localhost:11434
DREAMCODER_OLLAMA_LOCAL_ENABLED=false

# Hugging Face fallback lanes
DREAMCODER_HF_FALLBACK_ENABLED=true
DREAMCODER_CHAT_USE_RACE=0
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
HF_FALLBACK_MODEL=cognitivecomputations/dolphin-2.9-llama3-8b

# Agent shell
DREAMCODER_AGENT_UNRESTRICTED=0

# Backups
DREAMCODER_BACKUP_ON_SYNC_FAILURE=true
DREAMCODER_BACKUP_DIR=~/DreamCoder-backups

# GitHub live sync
GITHUB_TOKEN=
DREAMCODER_GITHUB_REPO=PcButNoBTC/DreamCoder
DREAMCODER_GITHUB_BRANCH=main
DREAMCODER_GITHUB_AUTOSYNC=true


# Production controls
DREAMCODER_AI_TIMEOUT=120
DREAMCODER_WATCH_DEBOUNCE=0.35
DREAMCODER_CHECKPOINT_DIR=~/.dreamcoder/checkpoints
DREAMCODER_AUDIT_LOG=~/.dreamcoder/audit.jsonl
DREAMCODER_AGENT_NETWORK=0
DREAMCODER_PROJECT_TEST_COMMAND=
DREAMCODER_PROJECT_BUILD_COMMAND=
GITHUB_APP_TOKEN=
